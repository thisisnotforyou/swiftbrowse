{
  "name": "swiftbrowse",
  "version": "0.4.0",
  "description": "A fast, privacy-minded cross-platform Chromium browser prototype",
  "main": "src/main.js",
  "author": "SwiftBrowse",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg zip --universal",
    "dist:windows": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "cross-fetch": "4.1.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.swiftbrowse.browser",
    "productName": "SwiftBrowse",
    "directories": {
      "output": "outputs/installers"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser;"
    }
  }
}
